# API service
H3_HOST=0.0.0.0
H3_PORT=8000
H3_API_KEY=
H3_MAX_UPLOAD_MB=2048
H3_MAX_QUEUE_SIZE=8
H3_ALLOW_INTERRUPT_RUNNING=false
H3_IDLE_RELEASE_SECONDS=5.0
H3_UPSCALE_IDLE_RELEASE_SECONDS=5.0

# Standalone local inference
H3_COMFY_CORE_PATH=.runtime/ComfyUI
H3_MODEL_DIR=models
H3_DATA_DIR=data
H3_DEVICE=cuda
H3_VRAM_MODE=dynamic
H3_RESERVE_VRAM_GB=1.0
H3_ENABLE_ACCELERATION_LORA=true

# SeedVR2 image upscaling (shares the H3 GPU queue)
H3_UPSCALE_RUNTIME_PATH=.runtime/SeedVR2
H3_UPSCALE_MODEL_DIR=models/SEEDVR2
H3_UPSCALE_DIT_MODEL=seedvr2_ema_3b_fp8_e4m3fn.safetensors
H3_UPSCALE_VAE_MODEL=ema_vae_fp16.safetensors
H3_UPSCALE_BLOCKS_TO_SWAP=16
H3_UPSCALE_VAE_TILE_SIZE=512
H3_UPSCALE_SWAP_IO=true
H3_UPSCALE_SEED=42

# Comfy-Org/MiniMax-H3 model filenames
H3_FL2VA_MODEL=minimax_h3_fl2va_pruned_int8_convrot.safetensors
H3_REF2VA_MODEL=minimax_h3_ref2va_pruned_int8_convrot.safetensors
H3_FL2VA_ACCELERATION_LORA=minimax_h3_fl2v_turbo_8step_v1.0_comfyui_bf16.safetensors
H3_REF2VA_ACCELERATION_LORA=minimax_h3_ref2v_turbo_4step_v0.1_comfyui_bf16.safetensors
H3_TEXT_ENCODER=qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors
H3_VIDEO_VAE=minimax_h3_video_vae_fp16.safetensors
H3_AUDIO_VAE=minimax_h3_audio_vae_fp32.safetensors

# H3 eager fallback only: 0 disables chunking and budget; fraction=1 disables budget.
H3_EAGER_CHUNK_ROWS=2048
H3_EAGER_MEMORY_FRACTION=0.7
