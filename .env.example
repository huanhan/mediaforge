# API service
H3_HOST=0.0.0.0
H3_PORT=8000
H3_API_KEY=
H3_MAX_UPLOAD_MB=2048
H3_MAX_QUEUE_SIZE=8
H3_ALLOW_INTERRUPT_RUNNING=false

# Standalone local inference
H3_COMFY_CORE_PATH=.runtime/ComfyUI
H3_MODEL_DIR=models
H3_DATA_DIR=data
H3_DEVICE=cuda
H3_VRAM_MODE=dynamic
H3_RESERVE_VRAM_GB=1.0

# Comfy-Org/MiniMax-H3 model filenames
H3_FL2VA_MODEL=minimax_h3_fl2va_pruned_int8_convrot.safetensors
H3_REF2VA_MODEL=minimax_h3_ref2va_pruned_int8_convrot.safetensors
H3_TEXT_ENCODER=qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors
H3_VIDEO_VAE=minimax_h3_video_vae_fp16.safetensors
H3_AUDIO_VAE=minimax_h3_audio_vae_fp32.safetensors
